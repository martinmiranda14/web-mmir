---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'experiencia'>;
}

const { entry } = Astro.props;
const { role, company, location, period, bullets } = entry.data;
---

<div class="timeline-item reveal">
  <span class="timeline-marker"></span>
  <div class="card card-hover">
    <div class="flex flex-wrap justify-between items-start gap-4 mb-1">
      <div>
        <h3 class="text-lg font-semibold" data-es={role.es} data-en={role.en}>
          {role.es}
        </h3>
        <p style="font-family: var(--font-mono); font-size: 0.9rem; color: var(--color-accent);">
          {company}
        </p>
      </div>
      <span
        class="timeline-date whitespace-nowrap"
        data-es={period.es}
        data-en={period.en}
      >
        {period.es}
      </span>
    </div>
    <p
      class="text-sm mb-4"
      style="color: var(--color-fg-muted);"
    >
      {location}
    </p>
    <ul class="bullet-list">
      {
        bullets.map((b) => (
          <li data-es={b.es} data-en={b.en}>
            {b.es}
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .timeline-item {
    position: relative;
    padding-left: 32px;
    margin-bottom: 48px;
  }
  .timeline-item:last-child {
    margin-bottom: 0;
  }
  .timeline-marker {
    position: absolute;
    left: 0;
    top: 36px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--color-accent);
    border: 3px solid var(--color-bg);
    box-shadow: 0 0 0 2px var(--color-accent);
  }
  .timeline-date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-fg-muted);
    background: var(--color-bg);
    padding: 4px 12px;
    border-radius: 6px;
    border: 1px solid var(--color-border);
  }
  @media (max-width: 600px) {
    .timeline-item .timeline-marker {
      top: 28px;
    }
  }
</style>
