---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/portfolio/Hero.astro';
import Section from '../components/ui/Section.astro';
import SectionTitle from '../components/ui/SectionTitle.astro';
import StatCard from '../components/portfolio/StatCard.astro';
import SkillCategoryCard from '../components/portfolio/SkillCategoryCard.astro';
import TimelineItem from '../components/portfolio/TimelineItem.astro';
import ProjectCard from '../components/portfolio/ProjectCard.astro';
import EducationCard from '../components/portfolio/EducationCard.astro';
import CertItem from '../components/portfolio/CertItem.astro';

const experiencias = (await getCollection('experiencia')).sort(
  (a, b) => a.data.order - b.data.order
);

const proyectos = (await getCollection('proyectos', ({ data }) => data.featured && !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const educacion = (await getCollection('educacion')).sort(
  (a, b) => a.data.order - b.data.order
);

const certificaciones = (await getCollection('certificaciones')).sort(
  (a, b) => a.data.order - b.data.order
);

const heroDescription =
  'Martín Miranda Mejías - Ingeniero Civil Telemático & DevOps Engineer. Kubernetes, AWS, GCP, Terraform.';

const skillCategories = [
  {
    titleEs: 'Orquestación y Contenedores',
    titleEn: 'Orchestration & Containers',
    iconSvg: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
    tags: ['Kubernetes', 'Docker', 'Helm'],
  },
  {
    titleEs: 'Cloud & IaC',
    titleEn: 'Cloud & IaC',
    iconSvg: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>`,
    tags: ['AWS', 'Google Cloud (GCP)', 'Terraform'],
  },
  {
    titleEs: 'Lenguajes',
    titleEn: 'Languages',
    iconSvg: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
    tags: ['TypeScript', 'JavaScript', 'Python'],
  },
  {
    titleEs: 'Monitoreo & Observabilidad',
    titleEn: 'Monitoring & Observability',
    iconSvg: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>`,
    tags: ['Prometheus', 'Grafana', 'ElasticSearch'],
  },
  {
    titleEs: 'Seguridad & Compliance',
    titleEn: 'Security & Compliance',
    iconSvg: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    tags: ['ISO 27001', 'Ciberseguridad', 'Hardening'],
  },
  {
    titleEs: 'Metodologías & Otros',
    titleEn: 'Methodologies & Others',
    iconSvg: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`,
    tags: ['CI/CD', 'DevOps', 'SRE', 'Git', 'Linux'],
  },
];

const educationIcons = {
  utfsm: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c0 2 3 3 6 3s6-1 6-3v-5"/></svg>`,
  salesianos: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>`,
} as const;
---

<BaseLayout title="Inicio" description={heroDescription} type="profile">
  <Hero />

  <Section id="about">
    <SectionTitle es="Sobre mí" en="About me" />
    <div class="grid md:grid-cols-2 gap-12 items-start">
      <div class="reveal space-y-4 text-base" style="color: var(--color-fg-muted); font-size: 1.05rem; line-height: 1.7;">
        <p
          data-es="Ingeniero Civil Telemático egresado de la Universidad Técnica Federico Santa María, con más de 3 años de experiencia en DevOps y SRE en Cotalker. Me apasiona construir infraestructura robusta, automatizar procesos y asegurar la disponibilidad de servicios críticos."
          data-en="Telecommunications Engineer graduated from Universidad Técnica Federico Santa María, with 3+ years of experience in DevOps and SRE at Cotalker. I'm passionate about building robust infrastructure, automating processes, and ensuring critical service availability."
        >
          Ingeniero Civil Telemático egresado de la Universidad Técnica Federico Santa María,
          con más de 3 años de experiencia en DevOps y SRE en Cotalker. Me apasiona construir
          infraestructura robusta, automatizar procesos y asegurar la disponibilidad de
          servicios críticos.
        </p>
        <p
          data-es="Participé en la migración completa de infraestructura de AWS a GCP, implementé controles de seguridad ISO 27001 y gestiono clusters de Kubernetes en producción. También desarrollo proyectos personales en desarrollo web fullstack y aplicaciones móviles."
          data-en="I participated in the complete infrastructure migration from AWS to GCP, implemented ISO 27001 security controls, and manage production Kubernetes clusters. I also develop personal projects in fullstack web development and mobile applications."
        >
          Participé en la migración completa de infraestructura de AWS a GCP, implementé
          controles de seguridad ISO 27001 y gestiono clusters de Kubernetes en producción.
          También desarrollo proyectos personales en desarrollo web fullstack y aplicaciones
          móviles.
        </p>
      </div>
      <div class="reveal grid grid-cols-2 gap-4">
        <StatCard number="3+" labelEs="Años de experiencia" labelEn="Years of experience" />
        <StatCard number="20+" labelEs="Repos en GitHub" labelEn="GitHub repos" />
        <StatCard number="ISO" labelEs="27001 Implementador" labelEn="27001 Implementer" />
        <StatCard number="2" labelEs="Proveedores Cloud" labelEn="Cloud Providers" />
      </div>
    </div>
  </Section>

  <Section id="skills" alt>
    <SectionTitle es="Habilidades Técnicas" en="Technical Skills" />
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {skillCategories.map((cat) => <SkillCategoryCard {...cat} />)}
    </div>
    <div class="text-center mt-10 reveal">
      <a href="/skills/" class="btn btn-outline" data-es="Ver detalle de skills" data-en="View skills detail">
        Ver detalle de skills
      </a>
    </div>
  </Section>

  <Section id="experience">
    <SectionTitle es="Experiencia Profesional" en="Professional Experience" />
    <div>
      {experiencias.map((exp) => <TimelineItem entry={exp} />)}
    </div>
  </Section>

  <Section id="projects" alt>
    <SectionTitle es="Proyectos Destacados" en="Featured Projects" />
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {proyectos.map((p) => <ProjectCard entry={p} />)}
    </div>
    <div class="text-center mt-10 reveal">
      <a href="/projects/" class="btn btn-outline" data-es="Ver todos los proyectos" data-en="View all projects">
        Ver todos los proyectos
      </a>
    </div>
  </Section>

  <Section id="education">
    <SectionTitle es="Educación y Certificaciones" en="Education & Certifications" />
    <div class="grid md:grid-cols-2 gap-5 mb-12">
      {
        educacion.map((e) => (
          <EducationCard
            entry={e}
            iconSvg={educationIcons[e.id as keyof typeof educationIcons] ?? educationIcons.utfsm}
          />
        ))
      }
    </div>

    <h3 class="reveal text-xl font-semibold mb-6" data-es="Certificaciones" data-en="Certifications">
      Certificaciones
    </h3>
    <div class="flex flex-col gap-3">
      {certificaciones.map((c) => <CertItem entry={c} />)}
    </div>
  </Section>

  <Section id="contact" alt>
    <SectionTitle es="Contacto" en="Contact" />
    <p
      class="reveal text-lg mb-9"
      style="color: var(--color-fg-muted);"
      data-es="¿Tienes un proyecto en mente o quieres conversar? Escríbeme."
      data-en="Have a project in mind or want to chat? Get in touch."
    >
      ¿Tienes un proyecto en mente o quieres conversar? Escríbeme.
    </p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <a href="mailto:contacto@martinmiranda.org" class="card card-hover reveal flex items-center gap-4 no-underline" style="color: var(--color-fg);">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-accent); flex-shrink: 0;">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
          <polyline points="22,6 12,13 2,6"/>
        </svg>
        <span class="text-sm">contacto@martinmiranda.org</span>
      </a>
      <a href="https://www.linkedin.com/in/martin-miranda-8761a9236" target="_blank" rel="noopener" class="card card-hover reveal flex items-center gap-4 no-underline" style="color: var(--color-fg);">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-accent); flex-shrink: 0;">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
          <rect x="2" y="9" width="4" height="12"/>
          <circle cx="4" cy="4" r="2"/>
        </svg>
        <span class="text-sm">LinkedIn</span>
      </a>
      <a href="https://github.com/martinmiranda14" target="_blank" rel="noopener" class="card card-hover reveal flex items-center gap-4 no-underline" style="color: var(--color-fg);">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-accent); flex-shrink: 0;">
          <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
        </svg>
        <span class="text-sm">GitHub</span>
      </a>
      <div class="card reveal flex items-center gap-4">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-accent); flex-shrink: 0;">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
          <circle cx="12" cy="10" r="3"/>
        </svg>
        <span class="text-sm">Valparaíso, Chile</span>
      </div>
    </div>
  </Section>
</BaseLayout>
