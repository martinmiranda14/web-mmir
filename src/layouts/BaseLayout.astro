---
import SEOHead from '../components/seo/SEOHead.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
}

const { title, description, image, imageAlt, type, noindex } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const fullTitle =
  title === 'Inicio'
    ? 'Martín Miranda | DevOps Engineer'
    : `${title} | Martín Miranda`;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <SEOHead
      title={fullTitle}
      description={description}
      canonical={canonicalUrl.href}
      image={image}
      imageAlt={imageAlt}
      type={type}
      noindex={noindex}
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // ===== LANGUAGE TOGGLE =====
      type Lang = 'es' | 'en';
      const STORAGE_KEY = 'mmir-lang';

      const initialLang = (localStorage.getItem(STORAGE_KEY) as Lang | null) ?? 'es';

      function applyLang(lang: Lang) {
        document.documentElement.lang = lang;
        document.querySelectorAll<HTMLElement>('[data-es][data-en]').forEach((el) => {
          const text = el.dataset[lang];
          if (text != null) el.textContent = text;
        });
        document.querySelectorAll<HTMLElement>('.lang-option').forEach((opt) => {
          opt.classList.toggle('active', opt.dataset.lang === lang);
        });
      }

      let currentLang: Lang = initialLang;
      applyLang(currentLang);

      const langToggle = document.getElementById('langToggle');
      langToggle?.addEventListener('click', () => {
        currentLang = currentLang === 'es' ? 'en' : 'es';
        localStorage.setItem(STORAGE_KEY, currentLang);
        applyLang(currentLang);
      });

      // ===== SCROLL REVEAL =====
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
